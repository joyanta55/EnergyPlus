
Version, 25.2;

GlobalGeometryRules,
  UpperLeftCorner,           !- Starting point of geometry
  CounterClockWise,          !- Vertex entry direction
  Relative;                  !- Coordinate system

Building,
  MyBuilding,                !- Name
  0.0,                       !- North Axis {deg}
  Suburbs,                   !- Terrain
  0.04,                      !- Loads Convergence Tolerance Value
  0.4,                       !- Temperature Convergence Tolerance Value
  FullExterior,              !- Solar Distribution
  25;                        !- Maximum Number of Warmup Days

ScheduleTypeLimits,
  AnyNumber,                !- Name
  -100,                     !- Lower Limit Value
  100,                      !- Upper Limit Value
  CONTINUOUS;               !- Numeric Type

Schedule:Compact,
  GPUUsageSchedule,         !- Name
  AnyNumber,                !- Schedule Type Limits Name
  Through: 12/31,
  For: AllDays,
  Until: 08:00, 0.2,        !- Light GPU usage
  Until: 18:00, 1.0,        !- Full load during working hours
  Until: 24:00, 0.3;        !- Light evening load

Schedule:Compact,
  CPUUsageSchedule,
  AnyNumber,
  Through: 12/31,
  For: AllDays,
  Until: 09:00, 0.7,
  Until: 18:00, 1.0,
  Until: 22:00, 0.3;

Schedule:Compact,
  RackUsageSchedule,
  AnyNumber,
  Through: 12/31,
  For: AllDays,
  Until: 24:00, 1.0;        !- Always on

Zone,
  Server_Zone,              !- Name
  0.0,                      !- Direction of Relative North {deg}
  0.0, 0.0, 0.0,            !- X, Y, Z Origin
  1.0, 1.0, 3.0,            !- Dimensions: Length, Width, Height
  1.0,                      !- Multiplier
  ,                         !- Ceiling Height
  ,                         !- Volume
  ,                         !- Floor Area
  ,                         !- Inside Convection Algorithm
  ,                         !- Outside Convection Algorithm
  ,                         !- Part of Total Floor Area
  ;                         !- Zone Conditioning Equipment List Name

ZoneHVAC:EquipmentConnections,
  Server_Zone,              !- Zone Name
  ServerEqList,             !- Equipment List Name
  ,                         !- Inlet Node
  ,                         !- Exhaust Node
  Server_Zone_AirNode,      !- Air Node Name
  ;                         !- Return Air Node Name

Rack:Component,
  Simple_Rack,              !- Rack Name
  Server_Zone,              !- Zone
  60,                       !- GPU Idle Power [W]
  6000,                     !- GPU Active Power [W]
  2,                        !- Total GPU Count
  12,                       !- CPU Idle Power [W]
  1200,                     !- CPU Active Power [W]
  8,                        !- Total CPU Count
  0,                        !- Fraction Latent
  0.1,                      !- Fraction Radiant
  0.0,                      !- Fraction Lost
  GPUUsageSchedule,         !- GPU Usage Schedule
  CPUUsageSchedule,         !- CPU Usage Schedule
  RackUsageSchedule,        !- Rack Level Schedule (for fan etc.)
  1.2,                      !- Cost per watt in USD
  150,                      !- Internal Fan Power [W]
  0.0,                      !- Fan Fraction Latent
  0.0,                      !- Fan Fraction Radiant
  0.0,                      !- Fan Fraction Lost
  10,                       !- NIC Count
  5,                        !- NIC Active Power per port
  3,                        !- NIC Idle Power per port
  15;                       !- NIC average utilization                       


ElectricEquipment,
  ServerRack1,       !- Name
  ServerZone,        !- Zone Name
  EquipmentSched,    !- Schedule Name
  Watts/Area,        !- Design Level Calculation Method
  10,                !- Power per Zone Floor Area {W/m2}
  0.8,               !- Fraction Latent
  0.2,               !- Fraction Radiant
  0.0;               !- Fraction Lost
